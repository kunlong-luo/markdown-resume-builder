{
  "name": "resume-craft",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.27 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
